# ───────── Database (PostgreSQL — Neon / Supabase / local Docker) ─────────
# Pooled connection string used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL if you have no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ───────── Site ─────────
# Public base URL, no trailing slash (used for emails, payment callbacks, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────── Auth.js ─────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Required on Vercel only if your deployment URL differs from NEXT_PUBLIC_SITE_URL
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Google login (optional — the Google button is hidden when these are empty)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ───────── Admin user created by `npm run db:seed` ─────────
ADMIN_EMAIL="admin@raziperfumes.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Razi Admin"

# ───────── Email ─────────
# Address that receives new-order and contact-form notifications
ADMIN_NOTIFY_EMAIL="orders@raziperfumes.com"
EMAIL_FROM="Razi Perfumes <no-reply@raziperfumes.com>"
# Option A: Resend (preferred). Option B: SMTP. If neither is set, emails are printed to the server console.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ───────── Image uploads (Cloudinary) ─────────
# If empty, admin uploads are saved to /public/uploads (local development only — Vercel's filesystem is read-only)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ───────── Online payments ─────────
# "myfatoorah" → real KNET / Visa-Mastercard / mada / Apple Pay via MyFatoorah
# "none"  → only Cash on Delivery is offered
# "mock"  → built-in sandbox gateway for local testing (never use in production)
# A real gateway (MyFatoorah / Tap) plugs into src/lib/payments — see README
PAYMENT_PROVIDER="none"
# Shared secret used to sign/verify payment webhooks
PAYMENT_WEBHOOK_SECRET=""
# Staging only: allow the sandbox gateway when NODE_ENV=production
ALLOW_MOCK_PAYMENTS="false"

# ───────── MyFatoorah ─────────
# Test (sandbox): https://apitest.myfatoorah.com with MyFatoorah's public test token:
#   SK_KWT_vVZlnnAqu8jRByOWaRPNId4ShzEDNt256dvnjebuyzo52dXjAfRx2ixW5umjWSUx
# Live: Kuwait/Bahrain/Oman/Jordan https://api.myfatoorah.com · Saudi https://api-sa.myfatoorah.com
#       UAE https://api-ae.myfatoorah.com · Qatar https://api-qa.myfatoorah.com (token from your MyFatoorah portal)
# MyFatoorah rejects "localhost" callback URLs — test on a Vercel preview deployment or a public tunnel.
MYFATOORAH_API_KEY=""
MYFATOORAH_BASE_URL="https://apitest.myfatoorah.com"
